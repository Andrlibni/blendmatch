// Postgres everywhere (Neon on Vercel). DATABASE_URL is the pooled connection
// used by the app; DATABASE_URL_UNPOOLED is the direct one used by migrations.
generator client {
  provider      = "prisma-client-js"
  // "rhel-openssl-3.0.x" is the runtime of Vercel serverless functions.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model TradeAccount {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  company      String
  contactName  String
  phone        String?
  businessType String?
  vatNumber    String
  country      String
  /// How the VAT number was checked: vies | hmrc | format | unverified
  vatCheck     String
  /// Company name returned by VIES / HMRC, if any
  vatCheckName String?
  vatCheckNote String?
  vatCheckedAt DateTime?
  approved     Boolean   @default(false)
  approvedAt   DateTime?
  /// trade | admin
  role         String    @default("trade")
  createdAt    DateTime  @default(now())
  orders       Order[]
}

model Order {
  id        String        @id @default(cuid())
  number    String        @unique
  /// retail | trade
  kind      String
  /// retail: paid_simulated | paid ; trade: draft | confirmed | cancelled
  status    String
  accountId String?
  account   TradeAccount? @relation(fields: [accountId], references: [id])
  email     String
  name      String
  company   String?
  vatNumber String?
  address   String
  city      String
  postcode  String
  country   String
  phone     String?
  notes     String?
  currency  String
  rate      Float
  vatRegime String?
  subtotal  Float
  discount  Float
  shipping  Float?
  vatTotal  Float
  /// JSON [{ rate, base, amount }] for trade orders
  vatBreakdown String?
  total     Float
  /// JSON snapshot of the priced lines at the time of the order
  lines     String
  createdAt DateTime      @default(now())
}
