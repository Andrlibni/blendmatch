# Database (SQLite in development; Postgres URL in production)
DATABASE_URL="file:./dev.db"

# Auth.js — generate with: npx auth secret
AUTH_SECRET="change-me-to-a-long-random-string"

# Public URL, used for canonical URLs, sitemap and JSON-LD
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Currency: how many GBP for 1 EUR
GBP_PER_EUR="0.86"

# VAT checks
VIES_ENABLED="true"
# HMRC "Check a UK VAT number" (v2.0, OAuth client credentials).
# Leave empty to accept UK numbers after format validation only.
HMRC_API_BASE="https://test-api.service.hmrc.gov.uk"
HMRC_CLIENT_ID=""
HMRC_CLIENT_SECRET=""

# Payments: "mock" (default) or "stripe"
PAYMENT_PROVIDER="mock"
STRIPE_SECRET_KEY=""
