# Database — Postgres.
# On Vercel these two are filled in automatically by the Neon integration.
# Locally: a Neon "dev" branch, or a local Postgres, e.g.
#   postgresql://lento:lento@localhost:5432/lento
DATABASE_URL="postgresql://lento:lento@localhost:5432/lento"
DATABASE_URL_UNPOOLED="postgresql://lento:lento@localhost:5432/lento"

# Auth.js — a long random string (https://generate-secret.vercel.app/32 or `npx auth secret`)
AUTH_SECRET="change-me-to-a-long-random-string"

# First administrator, created automatically on deploy if it does not exist yet
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Public URL, used for canonical URLs, sitemap and JSON-LD.
# On Vercel it defaults to the production domain; set it once you add your own domain.
NEXT_PUBLIC_SITE_URL=""

# Currency: how many GBP for 1 EUR
GBP_PER_EUR="0.86"

# VAT checks
VIES_ENABLED="true"
# HMRC "Check a UK VAT number" (v2.0, OAuth client credentials).
# Leave empty to accept UK numbers after format validation only.
HMRC_API_BASE="https://test-api.service.hmrc.gov.uk"
HMRC_CLIENT_ID=""
HMRC_CLIENT_SECRET=""

# Payments: "mock" (default) or "stripe"
PAYMENT_PROVIDER="mock"
STRIPE_SECRET_KEY=""
